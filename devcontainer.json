{
    "name": "Isaac ROS",
    "dockerComposeFile": "${localWorkspaceFolder}/.devcontainer_user/compose.user.yaml",
    "service": "isaac_ros",
    "overrideCommand": true,
    "workspaceFolder": "/workspaces",
    "initializeCommand": [
        "${localWorkspaceFolder}/.devcontainer/scripts/initialize_command",
        // Local paths.
        "LOCAL_WORKSPACE_DIRECTORY=${localWorkspaceFolder}",
        // Container paths and mount points.
        "CONTAINER_WORKSPACE_DIRECTORY=${containerWorkspaceFolder}"
    ],
    "postStartCommand": [
        "${containerEnv:REPOSITORY_DIRECTORY}/.devcontainer/scripts/post_start_command"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                // General settings.
                "editor.formatOnSave": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.mypy_cache": true
                },
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "args": [
                            "--login"
                        ]
                    }
                },
                "workbench.view.showQuietly": {
                    "workbench.panel.output": true
                },
                "docker.languageserver.formatter.ignoreMultilineInstructions": true,
                "docker.lsp.experimental.vulnerabilityScanning": false,
                "docker.extension.dockerEngineAvailabilityPrompt": false,
                "shellformat.effectLanguages": [
                    "shellscript",
                    "dotenv",
                    "hosts",
                    "jvmoptions",
                    "ignore",
                    "gitignore",
                    "properties",
                    "spring-boot-properties",
                    "azcli",
                    "bats"
                ],
                // Python settings.
                "python.languageServer": "Pylance",
                "debugpy.debugJustMyCode": false,
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "mypy-type-checker.args": [
                    "--config-file=${containerEnv:REPOSITORY_DIRECTORY}/.mypy.ini"
                ],
                // C++ settings.
                "[cpp]": {
                    "editor.defaultFormatter": "ms-vscode.cpptools"
                },
                "[cmake]": {
                    "editor.defaultFormatter": "josetr.cmake-language-support-vscode"
                },
                "cmake.languageSupport.dotnetPath": "/usr/bin/dotnet"
            },
            "extensions": [
                // General extensions.
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens",
                "GitHub.copilot",
                "foxundermoon.shell-format",
                "redhat.vscode-xml",
                "redhat.vscode-yaml",
                "ms-iot.vscode-ros",
                // Python extensions.
                "njpwerner.autodocstring",
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-python.mypy-type-checker",
                // C++ extensions.
                "ms-vscode.cpptools-extension-pack",
                "jeff-hykin.better-cpp-syntax",
                "josetr.cmake-language-support-vscode",
                "cschlosser.doxdocgen"
            ]
        }
    }
}