FROM ros:kilted-ros-core-noble

# Use bash as shell.
ENV SHELL=/bin/bash
SHELL ["/bin/bash", "-c"]
USER root

#########################################################################################################
# Update and install required apt-get and pip dependencies.                                                 #
#########################################################################################################
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        python3-pip \
        ros-kilted-rmw-zenoh-cpp && \
    apt-get -y autoremove && apt-get clean && rm -rf "/var/lib/apt/lists/"*

RUN git clone -b "kilted" --depth 1 "https://gitlab+deploy-token-37:gldt-e7yRzyyEP4y9QJgpLjRq@gitlab.hs-esslingen.de/smart-factory-grids/autonomous-systems/tools/zenoh-domain-bridge.git" && \
    cd "zenoh-domain-bridge" && \
    pip install --break-system-packages .

COPY .devcontainer/scripts/cross_domain_router_entrypoint /entrypoint
ENTRYPOINT ["/entrypoint"]
CMD ["-l", "debug"]