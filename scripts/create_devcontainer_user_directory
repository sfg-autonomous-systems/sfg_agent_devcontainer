#!/usr/bin/env bash

sfg_isaac_ros_devcontainer__create_devcontainer_user_directory() {
    local SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)
    source "${SCRIPT_DIR}/bash_utils/common"

    START_TEXT="> Creating devcontainer user directory."
    END_TEXT="< Done creating devcontainer user directory."

    sfg_bash_utils__print_info "${START_TEXT}"
    local DEVCONTAINER_USER_DIRECTORY=$(realpath "${ISAAC_ROS_DEVCONTAINER_PROJECT_ROOT}/../.devcontainer-user")
    local PROJECT_NAME=$(basename $(dirname "${DEVCONTAINER_USER_DIRECTORY}"))

    if [[ -d "${DEVCONTAINER_USER_DIRECTORY}" ]]; then
        sfg_bash_utils__print_error "Error: Devcontainer user directory already exists."
        exit 1
    fi

    mkdir -p "${DEVCONTAINER_USER_DIRECTORY}"
    echo ".env" >>"${DEVCONTAINER_USER_DIRECTORY}/.gitignore"
    PROJECT_NAME=${PROJECT_NAME} envsubst '${PROJECT_NAME}' <"${ISAAC_ROS_DEVCONTAINER_PROJECT_ROOT}/resources/dockerfile.template" >"${DEVCONTAINER_USER_DIRECTORY}/dockerfile"
    PROJECT_NAME=${PROJECT_NAME} envsubst '${PROJECT_NAME}' <"${ISAAC_ROS_DEVCONTAINER_PROJECT_ROOT}/resources/compose.yaml.template" >"${DEVCONTAINER_USER_DIRECTORY}/compose.yaml"
    echo "#!/usr/bin/env bash" >"${DEVCONTAINER_USER_DIRECTORY}/user_initialize_command"
    echo "#!/usr/bin/env bash" >"${DEVCONTAINER_USER_DIRECTORY}/user_post_start_command"
    chmod +x "${DEVCONTAINER_USER_DIRECTORY}/user_"*
    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    sfg_isaac_ros_devcontainer__create_devcontainer_user_directory "${@}"
fi
