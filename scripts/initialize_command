#!/usr/bin/env bash
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)/common"

execute_isaac_ros_devcontainer_initialize_command() {
    local local_workspace_directory="${1#*=}"
    local container_workspace_directory="${2#*=}"

    local START_TEXT="> Invoking initialize command for Isaac ROS devcontainer."
    local END_TEXT="< Done invoking initialize command for Isaac ROS devcontainer."

    print_info "${START_TEXT}"

    # Source all scripts.
    for script in "${ISAAC_ROS_DEVCONTAINER_PROJECT_ROOT}/scripts"/*; do
        source "${script}"
    done

    local ENVIRONMENT_FILE="${ISAAC_ROS_DEVCONTAINER_PROJECT_ROOT}/../.devcontainer-user/.env"

    set_up_mounted_directory "${ENVIRONMENT_FILE}" "${container_workspace_directory}"
    configure_ros_domain_id "${ENVIRONMENT_FILE}"
    setup_repository "${ENVIRONMENT_FILE}" "${local_workspace_directory}" "${container_workspace_directory}"
    setup_ntp_client
    forward_environment_variables "${ENVIRONMENT_FILE}" "${@}"
    forward_user "${ENVIRONMENT_FILE}"
    forward_platform "${ENVIRONMENT_FILE}"
    forward_jtop_gid "${ENVIRONMENT_FILE}"
    copy_build_dependencies
    execute_user_initialize_command "${local_workspace_directory}" "${@}"
    build_isaac_ros_base_image
    instantiate_isaac_ros_dockerfile_template "${local_workspace_directory}"
    print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    execute_isaac_ros_devcontainer_initialize_command "${@}"
fi
