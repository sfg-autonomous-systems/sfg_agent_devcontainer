#!/usr/bin/env bash

get_line_number_of_environment_variable() {
    local environment_file=${1}
    local environment_variable=${2}

    if [ ! -f "${environment_file}" ]; then
        echo -1
        return
    fi

    local line_number=$(grep -n "^${environment_variable}=" "${environment_file}" | cut -d: -f1)

    if [ -z "${line_number}" ]; then
        echo -1
        return
    fi

    echo ${line_number}
}

set_environment_variable() {
    local environment_file=${1}
    local environment_variable=${2}
    local value=${3}
    local line_number=$(get_line_number_of_environment_variable "${environment_file}" "${environment_variable}")

    if [ "${line_number}" -ne -1 ]; then
        sed -i "${line_number} c\\${environment_variable}=${value}" "${environment_file}"
    else
        echo "${environment_variable}=${value}" >>"${environment_file}"
    fi
}

get_environment_variable() {
    local environment_file=${1}
    local environment_variable=${2}

    if [ ! -f "${environment_file}" ]; then
        echo
        return
    fi

    echo $(grep -m1 "^${environment_variable}=.*" "${environment_file}" | cut -d= -f2)
}
